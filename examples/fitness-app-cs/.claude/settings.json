{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)"
    ],
    "ask": [
      "Bash(npx eas-cli@latest submit *)",
      "Bash(npx eas-cli@latest update *)",
      "Bash(npx supabase db push *)",
      "PowerShell(npx eas-cli@latest submit *)",
      "PowerShell(npx eas-cli@latest update *)",
      "PowerShell(npx supabase db push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(./secrets/**)",
      "Read(*.p8)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ]
  }
}
