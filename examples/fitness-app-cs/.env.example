# Jen názvy — nikdy skutečné hodnoty. Zkopíruj do mobile/.env a vyplň lokálně
# klíči z vývojových (dev) projektů. Produkční hodnoty jsou v EAS environment
# variables (buildy) a v Supabase secrets (Edge Functions).
# Pozor: vše s prefixem EXPO_PUBLIC_ je v aplikaci veřejně čitelné — sem patří
# jen klíče, které jsou veřejné z principu.

# Supabase (projekt fitness-dev) — kde: Project Settings → API · rozsah: URL a veřejný anon klíč, chráněno RLS
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat — kde: Project settings → API keys · rozsah: veřejné SDK klíče pro iOS a Android
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry (od T106) — kde: Project settings → Client Keys (DSN) · rozsah: jen odesílání chyb
EXPO_PUBLIC_SENTRY_DSN=

# NEPATŘÍ SEM: Supabase service_role klíč a tajemství webhooku RevenueCat —
# ty se nastavují jen jako Supabase secrets (`npx supabase secrets set …`).
