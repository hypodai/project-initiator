# Names only — never real values. Copy to .env.local and fill in locally.
# Production values live in Vercel environment variables (Production scope).

# Neon Postgres — where to get it: Neon console → project → dev branch → Connection string
# scope: the dev branch role only; the main-branch string goes to Vercel Production only
DATABASE_URL=

# Better Auth — generate a random 32+ byte secret per environment
BETTER_AUTH_SECRET=
# Base URL of this environment, e.g. http://localhost:<port>
BETTER_AUTH_URL=

# Google OAuth — where to get it: Google Cloud console → APIs & Services → Credentials
# scope: a separate OAuth client for development and for production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel AI Gateway — where to get it: Vercel dashboard → AI Gateway → API keys
# scope: development key with its own budget; production uses the Vercel project's credentials
AI_GATEWAY_API_KEY=
# Model id as listed in the AI Gateway model list; final choice in T203
AI_MODEL=
